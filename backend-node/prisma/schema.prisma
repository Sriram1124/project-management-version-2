generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id         String   @id @default(uuid())
  name       String
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  users         User[]
  projects      Project[]
  work_items    WorkItem[]
  sprints       Sprint[]
  forms         Form[]
  notifications Notification[]
  cohorts       Cohort[]
  action_items  ActionItem[]
  roles         Role[]
  work_policy   OrganizationWorkPolicy?
  audit_logs    AuditLog[]

  @@map("organizations")
}

model OrganizationWorkPolicy {
  id                  String   @id @default(uuid())
  organization_id     String   @unique
  office_start_time   String   @default("09:00")
  office_end_time     String   @default("17:30")
  break_start_time    String?
  break_end_time      String?
  lunch_break_minutes Int      @default(60)
  timezone            String   @default("Asia/Kolkata")
  overtime_enabled    Boolean  @default(false)
  overtime_start_time String?  @default("17:30")
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@map("organization_work_policies")
}

model User {
  id                   String   @id @default(uuid())
  organization_id      String?
  name                 String
  email                String   @unique
  user_code            String?
  cohort_id            String?
  batch                String?
  subbatch             String?
  must_change_password Boolean  @default(true)
  password_hash        String
  is_active            Boolean  @default(true)
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  organization           Organization?           @relation(fields: [organization_id], references: [id])
  cohort                 Cohort?                 @relation(fields: [cohort_id], references: [id], onDelete: SetNull)
  roles                  UserRole[]
  sessions               UserSession[]
  work_sessions          WorkSession[]
  time_entries           TimeEntry[]
  owned_projects         Project[]               @relation("ProjectOwner")
  project_memberships    ProjectMember[]
  created_work_items     WorkItem[]              @relation("WorkItemCreator")
  work_item_assignments  WorkItemAssignee[]
  created_forms          Form[]                  @relation("FormCreator")
  form_submissions       FormSubmission[]        @relation("FormSubmitter")
  sent_notifications     Notification[]          @relation("SentNotifications")
  received_notifications NotificationRecipient[] @relation("ReceivedNotifications")
  assigned_action_items  ActionItem[]            @relation("ActionItemAssignee")
  created_action_items   ActionItem[]            @relation("ActionItemCreator")
  work_item_comments     WorkItemComment[]       @relation("WorkItemCommentAuthor")
  audit_logs             AuditLog[]

  @@unique([organization_id, user_code])
  @@index([cohort_id])
  @@map("users")
}

model Cohort {
  id              String    @id @default(uuid())
  organization_id String
  name            String
  code            String
  description     String?
  start_date      DateTime?
  end_date        DateTime?
  is_active       Boolean   @default(true)
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  users        User[]

  @@unique([organization_id, code])
  @@index([organization_id])
  @@map("cohorts")
}

model WorkSession {
  id              String    @id @default(uuid())
  organization_id String
  user_id         String
  task_id         String?
  started_at      DateTime
  ended_at        DateTime?
  break_minutes   Int       @default(0)
  notes           String?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  user         User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  task         WorkItem?   @relation(fields: [task_id], references: [id], onDelete: SetNull)
  time_entries TimeEntry[]

  @@index([organization_id, user_id])
  @@index([user_id, started_at])
  @@index([user_id, task_id, ended_at])
  @@map("work_sessions")
}

model TimeEntry {
  id               String   @id @default(uuid())
  organization_id  String
  user_id          String
  task_id          String
  project_id       String?
  work_session_id  String?
  date             DateTime
  start_time       DateTime
  end_time         DateTime
  duration_minutes Int      @default(0)
  notes            String?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  user         User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  task         WorkItem     @relation(fields: [task_id], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [project_id], references: [id], onDelete: SetNull)
  work_session WorkSession? @relation(fields: [work_session_id], references: [id], onDelete: SetNull)

  @@index([organization_id, user_id, date])
  @@index([task_id])
  @@index([user_id, start_time])
  @@map("time_entries")
}

model Role {
  id              String   @id @default(uuid())
  name            String   @unique
  description     String?
  organization_id String?
  project_id      String?
  is_custom       Boolean  @default(false)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  organization    Organization?    @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  project         Project?         @relation(fields: [project_id], references: [id], onDelete: Cascade)
  users           UserRole[]
  permissions     RolePermission[]
  project_members ProjectMember[]

  @@index([organization_id])
  @@index([project_id])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  user_id String
  role_id String

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role Role @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@id([user_id, role_id])
  @@map("user_roles")
}

model RolePermission {
  role_id       String
  permission_id String

  role       Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@id([role_id, permission_id])
  @@map("role_permissions")
}

model UserSession {
  id                 String    @id @default(uuid())
  user_id            String
  refresh_token_hash String
  expires_at         DateTime
  created_at         DateTime  @default(now())
  revoked_at         DateTime?
  last_used_at       DateTime?
  user_agent         String?
  ip_address         String?

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("user_sessions")
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum ProjectMethodology {
  SCRUM
  KANBAN
}

model Project {
  id              String             @id @default(uuid())
  organization_id String
  owner_id        String
  name            String
  description     String?
  methodology     ProjectMethodology @default(SCRUM)
  start_date      DateTime?
  end_date        DateTime?
  status          ProjectStatus      @default(PLANNED)
  created_at      DateTime           @default(now())
  updated_at      DateTime           @updatedAt

  organization Organization      @relation(fields: [organization_id], references: [id])
  owner        User              @relation("ProjectOwner", fields: [owner_id], references: [id])
  members      ProjectMember[]
  documents    ProjectDocument[]
  work_items   WorkItem[]
  sprints      Sprint[]
  forms        Form[]
  time_entries TimeEntry[]
  action_items ActionItem[]
  roles        Role[]

  @@map("projects")
}

model ProjectMember {
  project_id   String
  user_id      String
  project_role String?
  role_id      String?

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role    Role?   @relation(fields: [role_id], references: [id], onDelete: SetNull)

  @@id([project_id, user_id])
  @@map("project_members")
}

model ProjectDocument {
  id            String   @id @default(uuid())
  project_id    String
  name          String
  document_type String
  storage_key   String
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  project      Project               @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@map("project_documents")
}

enum WorkItemType {
  EPIC
  STORY
  TASK
  SUBTASK
  BUG
}

enum WorkItemStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  COMPLETED
  BLOCKED
}

enum WorkItemPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

model Sprint {
  id              String       @id @default(uuid())
  organization_id String
  project_id      String
  name            String
  goal            String?
  start_date      DateTime?
  end_date        DateTime?
  status          SprintStatus @default(PLANNED)
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id])
  project      Project      @relation(fields: [project_id], references: [id], onDelete: Cascade)
  work_items   WorkItem[]

  @@index([organization_id, project_id])
  @@map("sprints")
}

model WorkItem {
  id              String           @id @default(uuid())
  organization_id String
  project_id      String?
  sprint_id       String?
  parent_id       String?
  created_by      String
  type            WorkItemType
  title           String
  description     String?
  status          WorkItemStatus   @default(TODO)
  priority        WorkItemPriority @default(MEDIUM)
  start_date      DateTime?
  due_date        DateTime?
  created_at      DateTime         @default(now())
  updated_at      DateTime         @updatedAt
  completed_at    DateTime?
  story_points    Int?             @default(0)

  organization  Organization         @relation(fields: [organization_id], references: [id])
  project       Project?             @relation(fields: [project_id], references: [id], onDelete: Cascade)
  sprint        Sprint?              @relation(fields: [sprint_id], references: [id], onDelete: SetNull)
  parent        WorkItem?            @relation("WorkItemHierarchy", fields: [parent_id], references: [id], onDelete: Restrict)
  children      WorkItem[]           @relation("WorkItemHierarchy")
  creator       User                 @relation("WorkItemCreator", fields: [created_by], references: [id])
  assignees     WorkItemAssignee[]
  attachments   WorkItemAttachment[]
  comments      WorkItemComment[]
  time_entries  TimeEntry[]
  work_sessions WorkSession[]

  @@index([organization_id])
  @@index([project_id])
  @@index([sprint_id])
  @@index([created_by])
  @@index([parent_id])
  @@map("work_items")
}

model WorkItemComment {
  id           String   @id @default(uuid())
  work_item_id String
  author_id    String
  content      String   @db.Text
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  work_item WorkItem @relation(fields: [work_item_id], references: [id], onDelete: Cascade)
  author    User     @relation("WorkItemCommentAuthor", fields: [author_id], references: [id], onDelete: Cascade)

  @@index([work_item_id])
  @@index([author_id])
  @@map("work_item_comments")
}

model WorkItemAssignee {
  work_item_id String
  user_id      String
  created_at   DateTime @default(now())

  work_item WorkItem @relation(fields: [work_item_id], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([work_item_id, user_id])
  @@map("work_item_assignees")
}

model WorkItemAttachment {
  id           String   @id @default(uuid())
  work_item_id String
  name         String
  storage_key  String
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  work_item WorkItem @relation(fields: [work_item_id], references: [id], onDelete: Cascade)

  @@index([work_item_id])
  @@map("work_item_attachments")
}

enum FormStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum QuestionType {
  SHORT_TEXT
  LONG_TEXT
  NUMBER
  SINGLE_SELECT
  MULTI_SELECT
  BOOLEAN
  DATE
}

model Form {
  id              String     @id @default(uuid())
  organization_id String
  project_id      String?
  creator_id      String
  title           String
  description     String?
  status          FormStatus @default(DRAFT)
  target_roles    String[] // e.g. ["INTERN"]
  deadline        DateTime?
  created_at      DateTime   @default(now())
  updated_at      DateTime   @updatedAt

  organization Organization     @relation(fields: [organization_id], references: [id])
  project      Project?         @relation(fields: [project_id], references: [id], onDelete: SetNull)
  creator      User             @relation("FormCreator", fields: [creator_id], references: [id])
  questions    FormQuestion[]
  submissions  FormSubmission[]

  @@index([organization_id])
  @@index([project_id])
  @@map("forms")
}

model FormQuestion {
  id          String       @id @default(uuid())
  form_id     String
  type        QuestionType
  text        String
  description String?
  is_required Boolean      @default(true)
  order_index Int
  options     String[] // For select type questions

  form    Form               @relation(fields: [form_id], references: [id], onDelete: Cascade)
  answers SubmissionAnswer[]

  @@index([form_id])
  @@map("form_questions")
}

model FormSubmission {
  id           String   @id @default(uuid())
  form_id      String
  submitter_id String
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  form      Form               @relation(fields: [form_id], references: [id], onDelete: Cascade)
  submitter User               @relation("FormSubmitter", fields: [submitter_id], references: [id])
  answers   SubmissionAnswer[]

  @@index([form_id])
  @@index([submitter_id])
  @@map("form_submissions")
}

model SubmissionAnswer {
  id            String   @id @default(uuid())
  submission_id String
  question_id   String
  value_string  String?
  value_number  Float?
  value_boolean Boolean?
  value_array   String[]

  submission FormSubmission @relation(fields: [submission_id], references: [id], onDelete: Cascade)
  question   FormQuestion   @relation(fields: [question_id], references: [id], onDelete: Cascade)

  @@index([submission_id])
  @@index([question_id])
  @@map("submission_answers")
}

enum NotificationType {
  BROADCAST
  DIRECT
  SYSTEM
  TASK_ASSIGNED
  FORM_ASSIGNED
}

model Notification {
  id              String           @id @default(uuid())
  organization_id String
  sender_id       String
  title           String
  message         String
  type            NotificationType @default(BROADCAST)
  created_at      DateTime         @default(now())
  updated_at      DateTime         @updatedAt

  organization Organization            @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  sender       User                    @relation("SentNotifications", fields: [sender_id], references: [id], onDelete: Cascade)
  recipients   NotificationRecipient[]

  @@index([organization_id])
  @@index([sender_id])
  @@map("notifications")
}

model NotificationRecipient {
  id              String    @id @default(uuid())
  notification_id String
  user_id         String
  read_at         DateTime?
  delivered       Boolean   @default(false)
  created_at      DateTime  @default(now())

  notification Notification @relation(fields: [notification_id], references: [id], onDelete: Cascade)
  user         User         @relation("ReceivedNotifications", fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([notification_id, user_id])
  @@index([notification_id])
  @@index([user_id])
  @@index([user_id, read_at])
  @@map("notification_recipients")
}

enum ActionItemStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ActionItemPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model ActionItem {
  id              String             @id @default(uuid())
  organization_id String
  project_id      String
  title           String
  description     String?
  status          ActionItemStatus   @default(OPEN)
  priority        ActionItemPriority @default(MEDIUM)
  assignee_id     String?
  creator_id      String             @map("creator_id")
  due_date        DateTime?
  created_at      DateTime           @default(now())
  updated_at      DateTime           @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [project_id], references: [id], onDelete: Cascade)
  assignee     User?        @relation("ActionItemAssignee", fields: [assignee_id], references: [id], onDelete: SetNull)
  creator      User         @relation("ActionItemCreator", fields: [creator_id], references: [id], onDelete: Cascade)

  @@index([organization_id])
  @@index([project_id])
  @@index([assignee_id])
  @@index([creator_id])
  @@map("action_items")
}

model AuditLog {
  id              String   @id @default(uuid())
  actor_id        String?
  organization_id String?
  action          String
  target_type     String
  target_id       String
  metadata        Json?
  ip_address      String?
  user_agent      String?
  created_at      DateTime @default(now())

  actor        User?         @relation(fields: [actor_id], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organization_id], references: [id], onDelete: SetNull)

  @@index([actor_id])
  @@index([organization_id])
  @@index([target_type, target_id])
  @@index([action, created_at])
  @@map("audit_logs")
}
