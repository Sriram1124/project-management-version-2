DATABASE_URL="postgresql://postgres:postgres@localhost:5432/project_management?schema=public"
JWT_ACCESS_SECRET="your_jwt_access_secret_here"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_here"
ACCESS_TOKEN_EXPIRY="15m"
REFRESH_TOKEN_EXPIRY="7d"
PORT=3001

# ── MongoDB Atlas (Project Files Metadata) ─────────────────────────────────
# Format: mongodb+srv://<username>:<password>@<cluster-address>/internhub?retryWrites=true&w=majority
MONGODB_URI="mongodb+srv://<db_user>:<db_password>@<cluster-host>/internhub?retryWrites=true&w=majority"
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=10

# ── Cloudflare R2 (Object Storage for Project Files) ───────────────────────
STORAGE_DRIVER="s3"
# Cloudflare R2 S3-compatible API endpoint: https://<account_id>.r2.cloudflarestorage.com
S3_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET="internhub-project-files"
S3_ACCESS_KEY_ID="<r2_access_key_id>"
S3_SECRET_ACCESS_KEY="<r2_secret_access_key>"
S3_FORCE_PATH_STYLE=false

# ── Feature Flags for Migration (Default to false during initial setup) ────
ENABLE_MONGODB_PROJECT_FILES=false
DUAL_WRITE_PROJECT_FILES=false
REVERSE_SYNC_TO_POSTGRES=false
