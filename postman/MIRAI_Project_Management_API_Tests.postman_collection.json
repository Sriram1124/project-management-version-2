{
  "info": {
    "_postman_id": "a7d903e1-789a-4c91-9e23-mirai-pm-suite-2026",
    "name": "MIRAI Adapter - Project Management API Test Suite",
    "description": "Read-only Postman test collection to verify that the deployed Project Management backend APIs (on Vercel) satisfy all contracts required by Sriram's MIRAI Project Management Integration Adapter.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "00 - Authentication",
      "description": "Optional helper request to log in and automatically populate the 'token' variable.",
      "item": [
        {
          "name": "00.1 - Login (Auto-populate token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Login status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.accessToken) {",
                  "    pm.environment.set(\"token\", jsonData.accessToken);",
                  "    console.log(\"Successfully extracted accessToken and updated 'token' environment variable!\");",
                  "}",
                  "if (jsonData.user && jsonData.user.organization_id) {",
                  "    pm.environment.set(\"organizationId\", jsonData.user.organization_id);",
                  "}",
                  "if (jsonData.user && jsonData.user.id) {",
                  "    pm.environment.set(\"userId\", jsonData.user.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Logs in with user credentials and automatically sets the {{token}} environment variable."
          }
        }
      ]
    },
    {
      "name": "01 - Projects",
      "description": "Endpoints for querying and retrieving project portfolio and individual project details.",
      "item": [
        {
          "name": "01.1 - List Projects (All / Default)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response is valid JSON with projects array\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an(\"object\");",
                  "    pm.expect(jsonData.projects).to.be.an(\"array\");",
                  "});",
                  "",
                  "pm.test(\"Project items adhere to adapter schema\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.projects.length > 0) {",
                  "        var p = jsonData.projects[0];",
                  "        pm.expect(p).to.have.property(\"id\");",
                  "        pm.expect(p.id).to.be.a(\"string\");",
                  "        pm.expect(p).to.have.property(\"name\");",
                  "        pm.expect(p).to.have.property(\"status\");",
                  "        pm.expect(p).to.have.property(\"methodology\");",
                  "        pm.expect(p).to.have.property(\"organization_id\");",
                  "        pm.expect(p).to.have.property(\"owner_id\");",
                  "        ",
                  "        // Auto-populate projectId if empty or unset",
                  "        if (!pm.environment.get(\"projectId\") || pm.environment.get(\"projectId\") === \"your_project_id_here\") {",
                  "            pm.environment.set(\"projectId\", p.id);",
                  "            console.log(\"Auto-set environment variable projectId to: \" + p.id);",
                  "        }",
                  "        if (!pm.environment.get(\"organizationId\") || pm.environment.get(\"organizationId\") === \"your_organization_id_here\") {",
                  "            if (p.organization_id) {",
                  "                pm.environment.set(\"organizationId\", p.organization_id);",
                  "                console.log(\"Auto-set environment variable organizationId to: \" + p.organization_id);",
                  "            }",
                  "        }",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/projects?limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["projects"],
              "query": [
                {
                  "key": "limit",
                  "value": "20",
                  "description": "Pagination limit"
                }
              ]
            },
            "description": "Lists accessible projects with pagination limit."
          }
        },
        {
          "name": "01.2 - List Projects (Filtered by Status=ACTIVE)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
