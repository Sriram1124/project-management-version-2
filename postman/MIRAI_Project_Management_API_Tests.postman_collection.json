    {
      "name": "02 - Work Items",
      "description": "Endpoints for querying tasks, stories, epics, and subtasks across the project hierarchy.",
      "item": [
        {
          "name": "02.1 - List Project Work Items",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response contains work_items array\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an(\"object\");",
                  "    pm.expect(jsonData.work_items).to.be.an(\"array\");",
                  "});",
                  "",
                  "pm.test(\"Work items adhere to hierarchy and association contracts\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    var targetProjectId = pm.environment.get(\"projectId\");",
                  "    if (jsonData.work_items.length > 0) {",
                  "        var item = jsonData.work_items[0];",
                  "        pm.expect(item).to.have.property(\"id\");",
                  "        pm.expect(item.id).to.be.a(\"string\");",
                  "        pm.expect(item).to.have.property(\"title\");",
                  "        pm.expect(item).to.have.property(\"type\");",
                  "        pm.expect(item).to.have.property(\"status\");",
                  "        pm.expect(item).to.have.property(\"priority\");",
                  "        ",
                  "        // Validate project association",
                  "        if (item.project_id) {",
                  "            pm.expect(item.project_id).to.eql(targetProjectId);",
                  "        }",
                  "        ",
                  "        // Capture userId if an assignee exists",
                  "        if (item.assignees && item.assignees.length > 0) {",
                  "            var uid = item.assignees[0].user_id || item.assignees[0].id;",
                  "            if (uid && (!pm.environment.get(\"userId\") || pm.environment.get(\"userId\") === \"your_user_id_here\")) {",
                  "                pm.environment.set(\"userId\", uid);",
                  "                console.log(\"Auto-set environment variable userId to: \" + uid);",
                  "            }",
                  "        }",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/work-items?project_id={{projectId}}&limit=50",
              "host": ["{{baseUrl}}"],
              "path": ["work-items"],
              "query": [
                {
                  "key": "project_id",
                  "value": "{{projectId}}",
                  "description": "Associated project UUID"
                },
                {
                  "key": "limit",
                  "value": "50",
                  "description": "Item limit"
                }
              ]
            },
            "description": "Retrieves work items for the specified project."
