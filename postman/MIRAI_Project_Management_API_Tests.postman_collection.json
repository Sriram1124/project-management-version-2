        {
          "name": "05.2 - List Organization Users",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response contains users array\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    var users = jsonData.users || jsonData.data;",
                  "    pm.expect(users).to.be.an(\"array\");",
                  "});",
                  "",
                  "pm.test(\"User items conform to identity mapping requirements\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    var users = jsonData.users || jsonData.data || [];",
                  "    if (users.length > 0) {",
                  "        var u = users[0];",
                  "        pm.expect(u).to.have.property(\"id\");",
                  "        pm.expect(u.id).to.be.a(\"string\");",
                  "        pm.expect(u).to.have.property(\"email\");",
                  "        pm.expect(u.email).to.include(\"@\");",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users?organization_id={{organizationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["users"],
              "query": [
                {
                  "key": "organization_id",
                  "value": "{{organizationId}}",
                  "description": "Scoped organization boundary"
                }
              ]
            },
            "description": "Lists users in the organization for canonical identity resolution."
          }
        }
      ]
    },
    {
