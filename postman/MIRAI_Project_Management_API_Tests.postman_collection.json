    {
      "name": "05 - Cohorts and Users",
      "description": "Endpoints for verifying organization-scoped cohort and user identities for canonical MIRAI mapping.",
      "item": [
        {
          "name": "05.1 - List Organization Cohorts",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response is an array of cohorts\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an(\"array\");",
                  "    if (jsonData.length > 0) {",
                  "        var c = jsonData[0];",
                  "        pm.expect(c).to.have.property(\"id\");",
                  "        pm.expect(c.id).to.be.a(\"string\");",
                  "        pm.expect(c).to.have.property(\"code\");",
                  "        pm.expect(c).to.have.property(\"name\");",
                  "        ",
                  "        if (!pm.environment.get(\"cohortId\") || pm.environment.get(\"cohortId\") === \"your_cohort_id_here\") {",
                  "            pm.environment.set(\"cohortId\", c.id);",
                  "            console.log(\"Auto-set environment variable cohortId to: \" + c.id);",
                  "        }",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
