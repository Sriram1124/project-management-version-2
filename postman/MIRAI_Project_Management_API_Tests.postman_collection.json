        {
          "name": "01.4 - Get Project Details by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Returns expected project matching requested ID\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    var expectedId = pm.environment.get(\"projectId\");",
                  "    pm.expect(jsonData.id).to.eql(expectedId);",
                  "    pm.expect(jsonData).to.have.property(\"name\");",
                  "    pm.expect(jsonData).to.have.property(\"status\");",
                  "    pm.expect(jsonData).to.have.property(\"methodology\");",
                  "    pm.expect(jsonData).to.have.property(\"organization_id\");",
                  "});",
                  "",
                  "pm.test(\"UUID is returned as a valid string\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.id).to.be.a(\"string\");",
                  "    pm.expect(jsonData.id.length).to.be.above(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/projects/{{projectId}}",
              "host": ["{{baseUrl}}"],
              "path": ["projects", "{{projectId}}"]
            },
            "description": "Retrieves comprehensive details for a specific project ID."
          }
        }
      ]
