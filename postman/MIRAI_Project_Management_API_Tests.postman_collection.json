    {
      "name": "03 - Sprints and Milestones",
      "description": "Endpoints for retrieving sprint cycles which map to NormalizedMilestone contracts in the MIRAI adapter.",
      "item": [
        {
          "name": "03.1 - List Project Sprints / Milestones",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response contains sprints or data array\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    var sprints = jsonData.sprints || jsonData.data;",
                  "    pm.expect(sprints).to.be.an(\"array\");",
                  "});",
                  "",
                  "pm.test(\"Sprint items conform to milestone mapping fields\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    var sprints = jsonData.sprints || jsonData.data || [];",
                  "    if (sprints.length > 0) {",
                  "        var s = sprints[0];",
                  "        pm.expect(s).to.have.property(\"id\");",
                  "        pm.expect(s.id).to.be.a(\"string\");",
                  "        pm.expect(s).to.have.property(\"name\");",
                  "        pm.expect(s).to.have.property(\"status\");",
                  "        pm.expect([\"PLANNED\", \"ACTIVE\", \"COMPLETED\"]).to.include(s.status);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/projects/{{projectId}}/sprints",
              "host": ["{{baseUrl}}"],
              "path": ["projects", "{{projectId}}", "sprints"]
            },
            "description": "Retrieves all sprint cycles for the project."
          }
        }
      ]
    },
